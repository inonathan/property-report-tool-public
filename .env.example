# ---------- App ----------
# Public URL of the app, used in emails and report links (no trailing slash)
APP_URL=http://localhost:3000
# URL the server uses to open its own pages for PDFs (defaults to APP_URL)
INTERNAL_URL=
# where the JSON store, PDFs and dry-run outboxes live
DATA_DIR=./data
# days until a report link expires
REPORT_TTL_DAYS=90

# ---------- Data provider ----------
# mock | cotality | valocity (a brand file can override this per agency)
# mock returns fictional, watermarked data
PROVIDER=mock

# ---------- Airtable (leave blank for dry-run: events are written to data/airtable-outbox.jsonl) ----------
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# ---------- Email via Postmark (leave blank for dry-run: emails are written to data/outbox/) ----------
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="Your Agency <reports@example.com>"
# optional internal copy of every email
EMAIL_BCC=

# ---------- PDF ----------
# local Chrome or Chromium; leave blank on serverless hosts to use @sparticuz/chromium
CHROME_PATH=/usr/bin/google-chrome

# ---------- Anti-abuse (optional) ----------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# sites allowed to embed the form in an iframe, comma-separated, or * for any
ALLOWED_EMBED_ORIGINS=*

# ---------- White-label ----------
# which brands/<id>.json to use, and where the contact buttons go
BRAND_ID=default
APPRAISAL_URL=
# demo only: show the "Preview as" bar
BRAND_SWITCH=

# ---------- Password gate (demo hosting only, leave empty otherwise) ----------
DEMO_USER=demo
DEMO_PASSWORD=
# optional signing secret for the session cookie (defaults to the password)
DEMO_SESSION_SECRET=
# after this date every request returns 410 Gone
DEMO_EXPIRES_AT=
